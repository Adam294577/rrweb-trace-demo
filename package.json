{
  "name": "rrweb-trace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green npm:dev:web npm:dev:api",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:web": "vite",
    "dev:api": "cd server && go run .",
    "test:api": "cd server && go vet ./... && go test ./..."
  },
  "dependencies": {
    "@rrweb/types": "2.2.2",
    "rrweb": "2.2.2",
    "rrweb-player": "2.2.2",
    "vue": "^3.5.44",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.7",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
